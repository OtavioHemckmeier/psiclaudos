{
  "name": "@laudo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests",
    "db:generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "db:validate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js validate",
    "db:push": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js db push",
    "db:backfill:evaluations": "node --env-file-if-exists=../../.env scripts/backfill-evaluation-updated-at.mjs"
  },
  "dependencies": {
    "@laudo/contracts": "0.1.0",
    "@laudo/rule-engine": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/pdfkit": "^0.13.8",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3"
  }
}
